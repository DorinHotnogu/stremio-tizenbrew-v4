{
  "name": "stremio-tizenbrew-v4",
  "appName": "Stremio v4",
  "version": "1.0.1",
  "description": "TizenBrew module: Stremio v4 web shell (app.strem.io/shell-v4.4) with ES2017+ polyfills for 2017-2018 Samsung TVs (Tizen 3.0/4.0, old Chromium).",
  "packageType": "mods",
  "websiteURL": "https://app.strem.io/shell-v4.4/",
  "main": "polyfills.js",
  "evaluateScriptOnDocumentStart": false,
  "keys": [
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "MediaTrackNext",
    "MediaTrackPrevious"
  ],
  "repository": {
    "url": "https://github.com/DorinHotnogu/stremio-tizenbrew-v4"
  },
  "license": "MIT"
}
